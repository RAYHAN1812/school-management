{
  "name": "school-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Ratonpur Central School — full-stack School ERP (React + Express + PostgreSQL)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:local": "npm run db:local --workspace server",
    "db:down": "docker compose stop db",
    "db:migrate": "npm run migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.14.6"
  }
}
