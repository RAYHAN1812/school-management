NODE_ENV=development
PORT=5000

# Local Postgres from `npm run db:local` (no Docker) or `docker compose up -d db`
DATABASE_URL=postgresql://sms:sms_dev_password@localhost:5432/sms?schema=public

# Use a long random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRES_IN=1d

# Frontend origin(s), comma-separated (CORS + links in emails)
CLIENT_URL=http://localhost:5173
PUBLIC_SCHOOL_CODE=GIS

# Cookie settings. In production behind HTTPS set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Bcrypt cost factor
BCRYPT_ROUNDS=12

# Where uploaded attachments are stored (relative to /server, or absolute)
UPLOAD_DIR=src/uploads

# Supabase Storage (profile-photos). Keep the service-role key only on the server.
SUPABASE_URL=https://sjhxmvmobrlojexybdpi.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_IHWWSNkRWlosQeI181Adgg_8TQcCWAR
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://sjhxmvmobrlojexybdpi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IHWWSNkRWlosQeI181Adgg_8TQcCWAR

# Online payments via SSLCommerz (optional). Without these, "Pay online" is hidden
# and parents are asked to pay at the office. Sandbox accounts: developer.sslcommerz.com
API_PUBLIC_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Password-reset emails: no mail provider is wired up yet. Reset links are
# written to the server log, and outside production they are also returned
# in the API response.
